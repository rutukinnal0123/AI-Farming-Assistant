import os
import shutil
from pathlib import Path

from langchain_community.document_loaders import PyPDFDirectoryLoader
from langchain_text_splitters import RecursiveCharacterTextSplitter

from langchain_huggingface import HuggingFaceEmbeddings

from langchain_chroma import Chroma

print("✅ All libraries imported successfully")


import os

DATASET = os.listdir("/kaggle/input/datasets")[0]

print(os.listdir(f"/kaggle/input/datasets/{DATASET}")[:20])


from pathlib import Path

PDF_FOLDER = Path("/kaggle/input/datasets/kinnalrutu/documents-for-agr")

pdf_files = list(PDF_FOLDER.rglob("*.pdf"))

print("=" * 60)
print(f"Total PDFs Found : {len(pdf_files)}")
print("=" * 60)

for pdf in pdf_files[:10]:
    print(pdf.name)


from langchain_community.document_loaders import PyPDFLoader

documents = []

print("=" * 60)
print("Loading PDFs...")
print("=" * 60)

for i, pdf in enumerate(pdf_files, start=1):

    try:

        loader = PyPDFLoader(str(pdf))

        pages = loader.load()

        # Store filename in metadata
        for page in pages:
            page.metadata["source_file"] = pdf.name

        documents.extend(pages)

        print(f"[{i}/{len(pdf_files)}] {pdf.name}  -> {len(pages)} pages")

    except Exception as e:

        print(f"Skipped: {pdf.name}")

        print(e)

print("\n" + "=" * 60)
print(f"Total Pages Loaded : {len(documents)}")
print("=" * 60)


splitter = RecursiveCharacterTextSplitter(

    chunk_size=1000,

    chunk_overlap=200

)

chunks = splitter.split_documents(documents)

print("=" * 60)
print(f"Total Chunks Created : {len(chunks)}")
print("=" * 60)

print("\nSample Chunk:\n")

print(chunks[0].page_content[:700])


from langchain_huggingface import HuggingFaceEmbeddings
from langchain_chroma import Chroma

embedding_model = HuggingFaceEmbeddings(
    model_name="BAAI/bge-small-en-v1.5"
)

vector_db = Chroma(
    persist_directory="/kaggle/working/chroma_db",
    embedding_function=embedding_model,
)

print("✅ ChromaDB Loaded Successfully")


import os

print(os.listdir("/kaggle/working/chroma_db"))


query = "how to grow wheat"

results = vector_db.similarity_search(
    query,
    k=5
)

print("="*80)

for i, doc in enumerate(results):

    print(f"\nResult {i+1}")

    print("-"*80)

    print("Source :", doc.metadata.get("source_file"))

    print()

    print(doc.page_content[:800])

    print()


import os
import google.generativeai as genai
from kaggle_secrets import UserSecretsClient

# Read API key from Kaggle Secrets
user_secrets = UserSecretsClient()
GOOGLE_API_KEY = user_secrets.get_secret("GOOGLE_API_KEY")

genai.configure(api_key=GOOGLE_API_KEY)

model = genai.GenerativeModel("gemini-2.5-flash")

print("✅ Gemini Connected Successfully")


def ask_farmer_assistant(question, k=5):

    # Retrieve relevant documents
    docs = vector_db.similarity_search(question, k=k)

    # Combine retrieved text
    context = "\n\n".join([doc.page_content for doc in docs])

    # Prompt
    prompt = f"""
You are AgriMitra, an intelligent farming assistant for Kerala farmers.

Your goal is to help farmers in simple and practical language.

Use the following priority while answering:

1. First use the information from the retrieved agricultural documents.
2. If the documents do not completely answer the question,
   use your agricultural knowledge to fill the gaps.
3. Never say "I don't know" unless absolutely necessary.
4. If you use your own knowledge, clearly mention:
   "This advice is based on general agricultural knowledge."

Rules:
- Use simple English.
- Avoid scientific jargon.
- Explain technical words if you must use them.
- Give practical step-by-step advice.
- Mention precautions.
- If the problem is serious, advise the farmer to contact the nearest Krishi Bhavan or agricultural officer.
- Do not invent dangerous recommendations.

======================
Knowledge Base
======================

{context}

======================
Farmer Question
======================

{question}

======================
Answer
======================
"""

    response = model.generate_content(prompt)

    return response.text


question = "how to grow wheat"

answer = ask_farmer_assistant(question)

print("="*80)
print("QUESTION")
print("="*80)
print(question)

print("\n")

print("="*80)
print("ANSWER")
print("="*80)
print(answer)


